{
  "name": "lift-me-up",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:single": "tsc --noEmit && vite build --config vite.config.single.ts",
    "typecheck": "tsc --noEmit",
    "push:plan": "tsx scripts/daily-push.ts --dry-run",
    "push:verify": "tsx scripts/verify-plan.ts && tsx scripts/test-api-handling.ts",
    "push:send": "tsx scripts/daily-push.ts"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/fira-sans-extra-condensed": "^5.3.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
